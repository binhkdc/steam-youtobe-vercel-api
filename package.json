{
  "name": "youtube-audio-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o ./yt-dlp && chmod +x ./yt-dlp && mkdir -p ~/.yt-dlp/plugins && curl -L https://github.com/coletrain7/yt-dlp-get-pot/releases/latest/download/yt-dlp-get-pot.zip -o ~/.yt-dlp/plugins/pot.zip"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  }
}